{
  "name": "402-announce",
  "version": "2.3.0",
  "type": "module",
  "description": "Announce HTTP 402 services (L402 and x402) on Nostr for decentralised discovery. Kind 31402 parameterised replaceable events.",
  "license": "MIT",
  "publishConfig": {
    "provenance": true
  },
  "main": "./build/index.js",
  "types": "./build/index.d.ts",
  "exports": {
    ".": {
      "import": "./build/index.js",
      "types": "./build/index.d.ts"
    },
    "./storage": {
      "import": "./build/storage.js",
      "types": "./build/storage.d.ts"
    },
    "./schemas/storage-service-v1.schema.json": "./schemas/storage-service-v1.schema.json"
  },
  "files": [
    "build",
    "schemas",
    "fixtures/storage-v1",
    "docs/storage-service-v1.md",
    "LICENSE",
    "README.md",
    "llms.txt",
    "llms-full.txt",
    "context7.json"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "fixtures:storage": "npm run build && node scripts/generate-storage-contract.mjs --check",
    "check:storage-package": "npm run build && node scripts/check-storage-package.mjs",
    "prepublishOnly": "npm run typecheck && npm run build && npm test && npm run fixtures:storage && npm run check:storage-package"
  },
  "dependencies": {
    "@noble/hashes": "2.0.1",
    "nostr-tools": "^2.12.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@vitest/coverage-v8": "^4.1.0",
    "ajv": "8.20.0",
    "typescript": "^5.7.0",
    "vitest": "^4.0.0"
  },
  "keywords": [
    "l402",
    "x402",
    "402",
    "nostr",
    "discovery",
    "lightning",
    "cashu",
    "mcp",
    "ai-agents",
    "machine-payments",
    "http-402",
    "bitcoin",
    "paywall",
    "micropayments",
    "decentralised"
  ],
  "homepage": "https://402.pub",
  "repository": {
    "type": "git",
    "url": "https://github.com/forgesworn/402-announce.git"
  },
  "engines": {
    "node": ">=18"
  },
  "funding": {
    "type": "lightning",
    "url": "lightning:profusemeat89@walletofsatoshi.com"
  }
}
