{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/forgesworn/402-announce/blob/main/schemas/storage-service-v1.schema.json",
  "title": "ForgeSworn public storage service description v1",
  "description": "Experimental kind 31402 storage extension. Structural validation must be followed by the semantic rules and signature checks in docs/storage-service-v1.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "service_pubkey",
    "identifier",
    "name",
    "about",
    "origins",
    "max_blob_bytes",
    "observed_at",
    "expires_at",
    "state",
    "checkout",
    "services"
  ],
  "properties": {
    "profile": {
      "const": "forgesworn-storage-service-v1"
    },
    "service_pubkey": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
    },
    "about": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
    },
    "origins": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048,
        "pattern": "^(https://[^/?#@\\s]+/|http://[a-z2-7]{56}\\.onion(:[0-9]+)?/)$"
      }
    },
    "max_blob_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "observed_at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "expires_at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "state": {
      "enum": [
        "published",
        "withdrawn"
      ]
    },
    "checkout": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/checkout"
        }
      ]
    },
    "services": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/free"
          },
          {
            "$ref": "#/$defs/paid"
          }
        ]
      }
    }
  },
  "$defs": {
    "free": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision",
        "availability",
        "type",
        "operation",
        "authorisation",
        "retention",
        "eviction_policy"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "availability": {
          "enum": [
            "accepting",
            "full",
            "paused",
            "unknown"
          ]
        },
        "type": {
          "const": "free-mirror"
        },
        "operation": {
          "const": "mirror"
        },
        "authorisation": {
          "const": "bud-11"
        },
        "retention": {
          "const": "best-effort"
        },
        "eviction_policy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^[^\\u0000-\\u0008\\u000b-\\u001f\\u007f]*$"
        }
      }
    },
    "paid": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision",
        "availability",
        "type",
        "capacity_bytes",
        "duration_seconds",
        "grace_seconds",
        "price_msat",
        "delivery_bytes",
        "delivery_policy",
        "retention_policy",
        "refund_policy"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "availability": {
          "enum": [
            "accepting",
            "full",
            "paused",
            "unknown"
          ]
        },
        "type": {
          "const": "paid-storage"
        },
        "capacity_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "duration_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "grace_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "price_msat": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "multipleOf": 1000
        },
        "delivery_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "delivery_policy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^[^\\u0000-\\u0008\\u000b-\\u001f\\u007f]*$"
        },
        "retention_policy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^[^\\u0000-\\u0008\\u000b-\\u001f\\u007f]*$"
        },
        "refund_policy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^[^\\u0000-\\u0008\\u000b-\\u001f\\u007f]*$"
        }
      }
    },
    "issuer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "note_endpoint",
        "callback",
        "mint_pubkey"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "note_endpoint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^https://[^/?#@\\s]+/[^?#\\s]*$"
        },
        "callback": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^https://[^/?#@\\s]+/[^?#\\s]*$"
        },
        "mint_pubkey": {
          "type": "string",
          "pattern": "^(02|03)[0-9a-f]{64}$"
        }
      }
    },
    "checkout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "origin",
        "network",
        "rails",
        "issuers"
      ],
      "properties": {
        "protocol": {
          "const": "wildbloom-checkout-v1"
        },
        "origin": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^https://[^/?#@\\s]+/$"
        },
        "network": {
          "enum": [
            "bitcoin",
            "testnet",
            "regtest"
          ]
        },
        "rails": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "lightning",
              "lnurlcash"
            ]
          }
        },
        "issuers": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/issuer"
          }
        }
      }
    }
  }
}
